POSTGRES_USER=fintech_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fintech_ledger

# RS256 JWT keypair. Generate locally with:
#   python backend/scripts/generate_jwt_keys.py
# Never commit the generated key files (backend/keys/ is gitignored).
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MINUTES=15
OTP_PEPPER=change_me_locally

MODEL_VERSION=rf_v3_2026_06
